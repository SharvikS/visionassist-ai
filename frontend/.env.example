# VisionAssist AI — frontend config
# Copy to .env.local for local development.

# Backend origin. The WebSocket URL is derived from this by swapping http->ws.
#
# IMPORTANT: this is inlined into the client bundle at build time, so it must be
# the URL a *browser* can reach. In Docker that means the published host port,
# not the compose service name.
#
# It is also enumerated in the Content-Security-Policy connect-src directive
# (see next.config.ts), so pointing the app at a different backend requires a
# rebuild rather than just an env change.
NEXT_PUBLIC_API_URL=http://localhost:8000
