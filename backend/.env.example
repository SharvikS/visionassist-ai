# VisionAssist AI — backend config
# NOTE: Provider API keys are BYOK — supplied by the client per request, NOT stored here.

# Comma-separated list of allowed CORS origins for the frontend.
VA_CORS_ORIGINS=http://localhost:3000

# Server bind host/port (used by run scripts, not by uvicorn --reload directly).
VA_HOST=0.0.0.0
VA_PORT=8000

# Upstream request timeout (seconds) for provider calls.
VA_PROVIDER_TIMEOUT=60

# Connect timeout (seconds). Kept short so a dead network fails fast instead of
# holding the request open for the full read budget.
VA_CONNECT_TIMEOUT=10

# Shared upstream connection pool. Keeping connections warm removes a TLS
# handshake from every request after the first — the single biggest win on
# time-to-first-token. Raise max_connections for higher concurrency.
VA_MAX_CONNECTIONS=100
VA_MAX_KEEPALIVE_CONNECTIONS=20
VA_KEEPALIVE_EXPIRY=60

# Close a WebSocket session that has been silent this long (seconds), so an
# abandoned tab doesn't pin a connection and its in-memory API key open.
VA_WS_IDLE_TIMEOUT=300
