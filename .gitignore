# ---- Coverage artifacts ----
# `.coverage` is a binary SQLite file rewritten by every test run, so tracking it
# puts an unreviewable diff in any commit that happened to run the suite.
.coverage
.coverage.*
coverage.xml
htmlcov/
coverage/

# ---- Playwright ----
playwright-report/
test-results/
.playwright/

# ---- Env & secrets ----
*.local
.DS_Store
*.pem
*.key

# ---- Editor ----
.idea/
.vscode/
*.swp

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
